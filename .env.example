# Leave empty to use the same-origin /signal WebSocket proxy.
VITE_RELAY_URL=
# Legacy alias accepted for existing deployments.
VITE_SIGNAL_URL=
# Optional JSON array of RTCIceServer objects. Use short-lived TURN credentials.
# Optional override. Leave unset to use Cloudflare public STUN.
# VITE_ICE_SERVERS=[]
# Render only: configure a TURN REST-compatible provider with the same secret.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
# Production relay: comma-separated allowed browser origins.
ALLOWED_ORIGINS=https://bridge.example.com
PORT=8787
